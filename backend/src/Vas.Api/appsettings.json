{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "AllowedTenantIds": "",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "SpaClientId": "00000000-0000-0000-0000-000000000000",
    "RequiredScope": "Dashboard.Read"
  },
  "Reporting": {
    "DataSource": "Fabric"
  },
  "Fabric": {
    "SqlEndpoint": "",
    "Database": "",
    "CommandTimeoutSeconds": 30
  },
  // Placeholder thresholds. Replace them when AEGI confirms the real ones, then set ArePlaceholders to false.
  "KpiThresholds": {
    "ArePlaceholders": true,
    "Kpis": {
      "approvalRate": { "Warning": 75, "Critical": 60, "HigherIsBetter": true },
      "averageTurnaroundDays": { "Warning": 10, "Critical": 15, "HigherIsBetter": false },
      "capacityUtilisation": { "Warning": 85, "Critical": 100, "HigherIsBetter": false }
    }
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "AllowedHosts": "*"
}
