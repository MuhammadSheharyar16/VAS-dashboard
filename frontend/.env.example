# Copy to .env for local development. .env is git-ignored. Neither value is a secret.

# Base path of the API. Always a relative path: the app and the API share one origin.
VITE_API_BASE_URL=/api/v1

# true  = fixtures in src/mocks and a fake signed-in user (no backend, no sign-in)
# false = the real API and Microsoft Entra ID sign-in
VITE_USE_MOCK=true
