# Copy to .env. Docker compose and run-dev.ps1 both read it at run time. .env is git-ignored.
# None of these are secrets, and no secret belongs in this file.
# Lines left commented out fall back to the defaults in appsettings.json.

# Entra ID (see docs/entra-setup.md)
# AzureAd__TenantId=
# AzureAd__ClientId=
# AzureAd__SpaClientId=

# Data source. Development uses Mock. Every other environment must use Fabric.
# Reporting__DataSource=Fabric
# Fabric__SqlEndpoint=
# Fabric__Database=

# Application Insights. Leave unset to keep telemetry off locally.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# API rate limit per user
# RateLimiting__PermitLimit=120
# RateLimiting__WindowSeconds=60
